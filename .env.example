# Copy to .env (and apps/web/.env.local for the web app). Demo mode and the simulation need none of these.
# Never commit the real file: it holds keys.

# ── Web app (apps/web) ──────────────────────────────────────────────
# NEAR network the app reads: mainnet unless this says testnet. The two below override that network's defaults.
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_NEAR_RPC=
# Pokers the browser tells to watch a funded guard (comma-separated URLs), e.g. http://localhost:8787
NEXT_PUBLIC_POKERS=
# Aurora's Intents widget (Widget Studio, studio.aurora.dev): pay a reserve from any wallet and token. Not secret.
NEXT_PUBLIC_AURORA_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The checker on OutLayer, called by the web server (sealed requests only) and by the pokers
OUTLAYER_API_BASE=https://api.outlayer.ai
CHECKER_PROJECT=ripcord-registry.near/checker
# OutLayer payment key (owner:nonce:secret) that pays for enclave runs: server-side only
OUTLAYER_PAYMENT_KEY=

# NEAR AI Cloud, for the plain-words set-up (requests are end-to-end encrypted to the model's TEE)
NEARAI_API_KEY=
NEARAI_MODEL=Qwen/Qwen3.8-27B

# ── Poker (services/poker) ──────────────────────────────────────────
HYPERLIQUID_API_BASE=https://api.hyperliquid.xyz
NEAR_RPC=https://rpc.mainnet.near.org
REGISTRY_CONTRACT=ripcord-registry.near
POKER_PORT=8787
# One pass per second; it calls the checker only inside this % band from liquidation
POKER_INTERVAL_MS=1000
POKER_BAND_PCT=30
# The watch list, encrypted at rest with POKER_STORE_KEY (32 characters or more)
POKER_STORE=poker-watch.json
POKER_STORE_KEY=

# ── Scripts ─────────────────────────────────────────────────────────
# Our own Hyperliquid test wallet's address, for `corepack pnpm testnet:checker poker`
TEST_WALLET_ADDRESS=
