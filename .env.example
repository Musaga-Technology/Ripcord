# ── Mode ────────────────────────────────────────────────────────────
# demo    = NEAR testnet + mock swap executor (no funds needed; AI judges use this)
# mainnet = real OutLayer custody + NEAR Intents swaps (small real amounts)
RIPCORD_MODE=demo
NEAR_NETWORK=testnet

# ── Contract ────────────────────────────────────────────────────────
ORDER_NFT_CONTRACT_ID=ripcord-orders.testnet
# Account that deploys the contract (local only; never commit its key)
DEPLOYER_ACCOUNT_ID=

# ── Checker (OutLayer) ──────────────────────────────────────────────
OUTLAYER_API_BASE=https://testnet-api.outlayer.fastnear.com
# GitHub source the checker WASM is compiled from (owner/repo@commit)
CHECKER_SOURCE=
# Enclave public key the web encrypts sealed triggers to (published by checker `pubkey` action)
NEXT_PUBLIC_CHECKER_PUBKEY=
# Payment key for OutLayer executions (poker uses this)
OUTLAYER_PAYMENT_KEY=

# ── NEAR Intents / 1Click ───────────────────────────────────────────
ONECLICK_API_BASE=https://1click.chaindefuser.com
# Partner JWT from https://partners.near-intents.org — server-side only.
# Required in v2: signed intents (generate-intent / submit-intent) use X-API-Key.
ONECLICK_PARTNER_JWT=
# Fee on fills in basis points, paid to RIPCORD_FEE_ACCOUNT via appFees
RIPCORD_FEE_BPS=50
RIPCORD_FEE_ACCOUNT=

# ── Hyperliquid (public info API, no key) ─────────────────────────
HYPERLIQUID_API_BASE=https://api.hyperliquid-testnet.xyz
# Poker calls the checker only when public distance to liquidation is inside this band
POKER_BAND_PCT=30

# ── Prices (optional in v2: Hyperliquid's mark price decides liquidations) ──
PYTH_HERMES_URL=https://hermes.pyth.network
# Hermes needs a key since Aug 26 2026 (401 without). Used for sanity checks and the hunt simulator.
PYTH_API_KEY=

# ── NEAR AI Cloud (private guard copilot) ──────────────────────────
NEARAI_API_BASE=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=

# ── Poker ───────────────────────────────────────────────────────────
# Hyperliquid's oracle updates ≈ every 3 s; polling faster gains nothing (ARCHITECTURE §4.2)
POKER_INTERVAL_MS=3000
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_ORDER_NFT_CONTRACT_ID=ripcord-orders.testnet
